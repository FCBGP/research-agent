{
  "name": "@basil/dsh-research",
  "version": "0.2.1",
  "description": "dsh-routing-research bundle for dsh: inter-domain routing security (BGP / RPKI / BGPsec / ASPA / VRO / CRC / FC-BGP; FRR / VPP executors) research/verification/experiment loops, artifact store, domain skills, Web right-sidebar TRIZ explainer. Operational command stays `dsh research`.",
  "type": "module",
  "scripts": {
    "test": "node --test \"src/**/*.test.ts\"",
    "smoke:runtime": "DSH_HOME=${DSH_HOME:?run ./scripts/deploy-profile.sh first} node scripts/runtime-smoke.mjs",
    "deploy:profile": "./scripts/deploy-profile.sh",
    "pack": "./scripts/pack.sh",
    "prepack": "echo '⛔ no direct npm pack/publish: use npm run pack (builds bootable .js staging + packs) -- see scripts/pack.sh' >&2; exit 1",
    "build": "node scripts/build.mjs",
    "build:client": "node scripts/build-client.mjs"
  },
  "files": [
    "src",
    "client",
    "lib",
    "cordis.patch.yml",
    "presets",
    "patches",
    "skills",
    "scripts/runtime-smoke.mjs",
    "scripts/build-client.mjs",
    "README.md"
  ],
  "publishConfig": {
    "access": "public"
  },
  "dsh": {
    "bundle": {
      "patch": [
        "./cordis.patch.yml",
        "./presets/research.patch.yml",
        "./presets/roles.patch.yml"
      ]
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-ui-sidebar-right"
      ]
    }
  },
  "main": "./src/plugin-core.ts",
  "exports": {
    ".": {
      "types": "./src/plugin-core.ts",
      "default": "./src/plugin-core.ts"
    },
    "./core": {
      "types": "./src/plugin-core.ts",
      "default": "./src/plugin-core.ts"
    },
    "./director": {
      "types": "./src/plugin-director.ts",
      "default": "./src/plugin-director.ts"
    },
    "./experiment": {
      "types": "./src/plugin-experiment.ts",
      "default": "./src/plugin-experiment.ts"
    },
    "./writer": {
      "types": "./src/plugin-writer.ts",
      "default": "./src/plugin-writer.ts"
    },
    "./operations": {
      "types": "./src/plugin-operations.ts",
      "default": "./src/plugin-operations.ts"
    },
    "./triz": {
      "types": "./src/plugin-triz.ts",
      "default": "./src/plugin-triz.ts"
    },
    "./triz-ui": {
      "types": "./src/plugin-triz-ui.ts",
      "default": "./src/plugin-triz-ui.ts"
    },
    "./triz-auto": {
      "types": "./src/plugin-triz-auto.ts",
      "default": "./src/plugin-triz-auto.ts"
    },
    "./tools": {
      "types": "./src/plugin-tools.ts",
      "default": "./src/plugin-tools.ts"
    },
    "./client": {
      "default": "./lib/client.js"
    },
    "./src/*": "./src/*",
    "./package.json": "./package.json",
    "./triza": {
      "types": "./src/plugin-triza.ts",
      "default": "./src/plugin-triza.ts"
    }
  },
  "devDependencies": {
    "esbuild": "^0.28.2"
  }
}
