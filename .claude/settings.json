{
  "permissions": {
    "allow": ["web_search", "web_fetch", "arxiv_search", "scholar_search", "read_file", "read_pdf", "list_dir", "write_report", "save_note", "read_notes", "recall_facts", "Grep"],
    "deny": []
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "WebFetch|Write",
        "hooks": [{"type": "command", "command": "echo before tool"}]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Write|Edit",
        "hooks": [{"type": "command", "command": "echo after tool"}]
      }
    ]
  }
}